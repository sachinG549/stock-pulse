# Copy to .env for local runs. Do not commit .env.
# GitHub Actions reads the same names from repository secrets.
# Leave a value blank to omit it. TWILIO_WHATSAPP_FROM falls back to
# Twilio's public WhatsApp sandbox sender when it is unset or blank.

NEWSAPI_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TARGET_PHONE_NUMBER=whatsapp:+91XXXXXXXXXX
